@model IEnumerable<CarSalesManagementSystemClient.Models.PartViewModel>
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Quan ly Phu tung - Admin";
    var categories = ViewBag.Categories as IEnumerable<CarSalesManagementSystemClient.Models.PartCategoryViewModel> ?? new List<CarSalesManagementSystemClient.Models.PartCategoryViewModel>();
}

<link href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;500;600;700;800&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">

<style>
    .parts-admin-page { font-family: "Outfit", sans-serif; background: #f3f4f6; min-height: 100vh; }
    .hero-card { background: linear-gradient(135deg, #15171c, #24272e); border-radius: 22px; padding: 30px 34px; margin-bottom: 24px; color: #fff; position: relative; overflow: hidden; }
    .hero-card::after { content: "PARTS"; position: absolute; top: -20px; right: 20px; font-size: 7rem; font-weight: 900; color: rgba(255,255,255,0.04); pointer-events: none; }
    .hero-eyebrow { color: #f5b800; font-size: 0.62rem; font-weight: 900; letter-spacing: 0.17em; text-transform: uppercase; margin-bottom: 8px; }
    .hero-title { font-size: 2rem; font-weight: 950; margin: 0 0 6px; letter-spacing: -0.04em; }
    .hero-sub { color: rgba(255,255,255,0.55); font-size: 0.8rem; }
    .tab-bar { display: flex; gap: 8px; background: #fff; border: 1px solid #e5e7eb; border-radius: 14px; padding: 6px; margin-bottom: 20px; box-shadow: 0 4px 12px rgba(17,19,24,0.05); }
    .tab-btn { display: inline-flex; align-items: center; gap: 7px; padding: 10px 16px; border: 1px solid transparent; border-radius: 10px; font-size: 0.68rem; font-weight: 900; background: transparent; color: #636870; cursor: pointer; white-space: nowrap; transition: all 0.2s; }
    .tab-btn.active { background: linear-gradient(135deg, #15171c, #24272e); color: #f5b800; border-color: #15171c; box-shadow: 0 6px 16px rgba(17,19,24,0.18); }
    .tab-btn.active i { color: #f5b800; }
    .tab-btn:hover:not(.active) { background: #f5f6f7; color: #181a1f; }
    .content-card { background: #fff; border: 1px solid #e5e7eb; border-radius: 20px; box-shadow: 0 8px 24px rgba(17,19,24,0.07); overflow: hidden; margin-bottom: 24px; }
    .content-card-header { padding: 20px 24px; border-bottom: 1px solid #e5e7eb; display: flex; align-items: center; justify-content: space-between; gap: 16px; background: linear-gradient(135deg,#fff,#fafafa); }
    .content-card-header h2 { margin: 0 0 3px; font-size: 0.95rem; font-weight: 950; color: #181a1f; }
    .content-card-header p { margin: 0; color: #747983; font-size: 0.67rem; }
    .table { margin: 0; }
    .table thead th { padding: 12px 14px; font-size: 0.58rem; font-weight: 900; letter-spacing: 0.06em; text-transform: uppercase; color: #777d86; background: #f8f9fa; border-bottom: 1px solid #e5e7eb; white-space: nowrap; }
    .table tbody td { padding: 13px 14px; font-size: 0.68rem; color: #50565f; border-bottom: 1px solid #edf0f3; vertical-align: middle; }
    .table tbody tr:last-child td { border-bottom: 0; }
    .table tbody tr:hover td { background: #fffdf6; }
    .part-img { width: 52px; height: 52px; border-radius: 10px; object-fit: cover; border: 1px solid #e5e7eb; }
    .part-name { font-size: 0.74rem; font-weight: 900; color: #181a1f; }
    .part-code { display: inline-flex; padding: 4px 8px; background: #f3f4f6; border: 1px solid #e1e3e7; border-radius: 7px; font-size: 0.6rem; color: #5d626b; font-family: monospace; }
    .badge-status-active { background: #effbf4; color: #166534; border: 1px solid #bbf7d0; border-radius: 999px; padding: 5px 9px; font-size: 0.57rem; font-weight: 900; }
    .badge-status-inactive { background: #fff2f3; color: #991b1b; border: 1px solid #fecaca; border-radius: 999px; padding: 5px 9px; font-size: 0.57rem; font-weight: 900; }
    .btn-edit { background: #fffdf6; color: #8a6800; border: 1px solid #e8cf7d; border-radius: 8px; padding: 6px 11px; font-size: 0.61rem; font-weight: 900; cursor: pointer; transition: all 0.2s; }
    .btn-edit:hover { background: #f5b800; color: #181a1f; }
    .btn-del { background: #fff2f3; color: #991b1b; border: 1px solid #fecaca; border-radius: 8px; padding: 6px 11px; font-size: 0.61rem; font-weight: 900; cursor: pointer; transition: all 0.2s; }
    .btn-del:hover { background: #dc3545; color: #fff; }
    .btn-primary-add { display: inline-flex; align-items: center; gap: 7px; padding: 10px 16px; background: #f5b800; color: #181a1f; border: 1px solid #f5b800; border-radius: 11px; font-size: 0.68rem; font-weight: 900; cursor: pointer; transition: all 0.2s; text-decoration: none; }
    .btn-primary-add:hover { background: #ffca28; transform: translateY(-2px); }
    .search-bar { display: flex; align-items: center; gap: 10px; padding: 16px 24px; border-bottom: 1px solid #e5e7eb; }
    .search-bar input, .search-bar select { height: 42px; border: 1px solid #e5e7eb; border-radius: 10px; padding: 8px 14px; font-size: 0.72rem; background: #f8f9fa; outline: none; transition: border-color 0.2s, box-shadow 0.2s; }
    .search-bar input { flex: 1; padding-left: 38px; }
    .search-bar input:focus, .search-bar select:focus { border-color: #f5b800; box-shadow: 0 0 0 3px rgba(245,184,0,0.13); background: #fff; }
    .search-icon { position: relative; flex: 1; }
    .search-icon i { position: absolute; left: 12px; top: 50%; transform: translateY(-50%); color: #9a9fa7; font-size: 0.82rem; pointer-events: none; }
    .empty-state { text-align: center; padding: 55px 24px; color: #747983; }
    .empty-state i { font-size: 2.5rem; color: #d0d3d9; margin-bottom: 12px; }
    .modal-content { border-radius: 20px !important; border: 0 !important; box-shadow: 0 30px 80px rgba(17,19,24,0.25) !important; }
    .modal-header { background: linear-gradient(135deg,#15171c,#24272e) !important; color: #fff; padding: 18px 22px !important; border: 0; }
    .modal-title { color: #fff; font-size: 0.9rem; font-weight: 950; }
    .modal-title i { color: #f5b800; }
    .modal-body { padding: 24px !important; }
    .form-label { font-size: 0.68rem; font-weight: 900; color: #43474f; margin-bottom: 6px; }
    .form-control, .form-select { min-height: 44px; border-radius: 10px; border: 1px solid #e5e7eb; font-size: 0.72rem; background: #f8f9fa; }
    .form-control:focus, .form-select:focus { border-color: #f5b800; box-shadow: 0 0 0 3px rgba(245,184,0,0.13); background: #fff; }
    .img-preview-box { position: relative; width: 80px; height: 80px; border-radius: 10px; overflow: hidden; border: 2px solid #e2e4e8; background: #eceef1; }
    .img-preview-box img { width: 100%; height: 100%; object-fit: cover; }
    .img-preview-box .btn-rm { position: absolute; top: 4px; right: 4px; width: 20px; height: 20px; display: flex; align-items: center; justify-content: center; background: rgba(220,53,69,0.9); color: #fff; border: none; border-radius: 50%; font-size: 10px; cursor: pointer; }
</style>

<div class="parts-admin-page">
    <div class="container-fluid px-4 py-4">

        <!-- Hero -->
        <div class="hero-card">
            <div class="hero-eyebrow"><span style="width:7px;height:7px;background:#f5b800;border-radius:50%;display:inline-block;margin-right:8px;"></span>QUAN LY KHO</div>
            <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">
                <div>
                    <h1 class="hero-title">Quan ly Phu Tung</h1>
                    <p class="hero-sub mb-0">CRUD danh muc va phu tung o to trong he thong.</p>
                </div>
                <div class="d-flex gap-2 flex-wrap">
                    <button type="button" class="btn-primary-add" onclick="openAddCategoryModal()">
                        <i class="bi bi-folder-plus"></i> Them danh muc
                    </button>
                    <button type="button" class="btn-primary-add" onclick="openAddPartModal()">
                        <i class="bi bi-plus-circle-fill"></i> Them phu tung
                    </button>
                </div>
            </div>
        </div>

        @if (ViewBag.ErrorMessage != null)
        {
            <div class="alert alert-danger rounded-3 mb-4">@ViewBag.ErrorMessage</div>
        }

        <!-- Tabs -->
        <div class="tab-bar">
            <button class="tab-btn active" id="tabBtnParts" onclick="switchTab('parts')">
                <i class="bi bi-boxes"></i> 1. QUAN LY PHU TUNG
            </button>
            <button class="tab-btn" id="tabBtnCats" onclick="switchTab('cats')">
                <i class="bi bi-tags-fill"></i> 2. QUAN LY DANH MUC
            </button>
        </div>

        <!-- Tab: Parts -->
        <div id="tabParts">
            <div class="content-card">
                <div class="search-bar">
                    <div class="search-icon">
                        <i class="bi bi-search"></i>
                        <input type="search" id="searchTerm" placeholder="Tim theo ten hoac ma phu tung..." oninput="filterTable()">
                    </div>
                    <select id="filterCat" onchange="filterTable()" style="min-width:180px;">
                        <option value="">Tat ca danh muc</option>
                        @foreach (var cat in categories)
                        {
                            <option value="@cat.CategoryName">@cat.CategoryName</option>
                        }
                    </select>
                </div>
                <div class="content-card-header">
                    <div>
                        <h2>Danh sach phu tung</h2>
                        <p>@Model.Count() mat hang trong he thong</p>
                    </div>
                </div>
                <div class="table-responsive">
                    <table class="table" id="partsTable">
                        <thead>
                            <tr>
                                <th class="ps-4">Phu tung</th>
                                <th>Ma SP</th>
                                <th>Danh muc</th>
                                <th>Thuong hieu</th>
                                <th>Gia ban</th>
                                <th>Trang thai</th>
                                <th class="text-end pe-4">Thao tac</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model == null || !Model.Any())
                            {
                                <tr>
                                    <td colspan="7">
                                        <div class="empty-state">
                                            <i class="bi bi-box-seam d-block"></i>
                                            <strong>Chua co phu tung nao</strong>
                                            <p class="mt-1">Nhan "Them phu tung" de bat dau.</p>
                                        </div>
                                    </td>
                                </tr>
                            }
                            else
                            {
                                foreach (var part in Model)
                                {
                                    var imgs = (part.ImageUrl ?? "").Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
                                    var img = imgs.Length > 0 ? imgs[0] : "https://images.unsplash.com/photo-1486006920555-c77dce18193b?auto=format&fit=crop&w=100&q=80";
                                    <tr>
                                        <td class="ps-4">
                                            <div class="d-flex align-items-center gap-3">
                                                <img src="@img" alt="@part.PartName" class="part-img" />
                                                <span class="part-name">@part.PartName</span>
                                            </div>
                                        </td>
                                        <td><span class="part-code">@part.PartCode</span></td>
                                        <td>@part.Category?.CategoryName</td>
                                        <td>@part.Brand</td>
                                        <td><strong class="text-danger">@part.Price.ToString("N0") d</strong></td>
                                        <td>
                                            @if (part.Status == "Inactive")
                                            {
                                                <span class="badge-status-inactive">Ngung ban</span>
                                            }
                                            else
                                            {
                                                <span class="badge-status-active">Dang ban</span>
                                            }
                                        </td>
                                        <td class="text-end pe-4">
                                            <button class="btn-edit me-1" onclick="openEditPartModal(@part.PartId)">
                                                <i class="bi bi-pencil-square"></i> Sua
                                            </button>
                                            <button class="btn-del" onclick="deletePart(@part.PartId, '@part.PartName.Replace("'", "\\'")')">
                                                <i class="bi bi-trash"></i> Xoa
                                            </button>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- Tab: Categories -->
        <div id="tabCats" style="display:none;">
            <div class="content-card">
                <div class="content-card-header">
                    <div>
                        <h2>Danh muc phu tung</h2>
                        <p>Quan ly cac nhom phu tung trong he thong</p>
                    </div>
                    <button class="btn-primary-add" onclick="openAddCategoryModal()">
                        <i class="bi bi-plus-circle"></i> Them danh muc
                    </button>
                </div>
                <div class="table-responsive">
                    <table class="table">
                        <thead>
                            <tr>
                                <th class="ps-4">ID</th>
                                <th>Ten danh muc</th>
                                <th>Mo ta</th>
                                <th class="text-end pe-4">Thao tac</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (!categories.Any())
                            {
                                <tr><td colspan="4" class="text-center py-4 text-muted">Chua co danh muc nao.</td></tr>
                            }
                            else
                            {
                                foreach (var cat in categories)
                                {
                                    <tr>
                                        <td class="ps-4">#@cat.CategoryId</td>
                                        <td><strong>@cat.CategoryName</strong></td>
                                        <td class="text-muted">@(string.IsNullOrWhiteSpace(cat.Description) ? "-" : cat.Description)</td>
                                        <td class="text-end pe-4">
                                            <button class="btn-edit" onclick="openEditCategoryModal(@cat.CategoryId, '@cat.CategoryName', '@cat.Description')">
                                                <i class="bi bi-pencil-square"></i> Sua
                                            </button>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

    </div>
</div>

<!-- MODAL: Them / Sua Phu Tung -->
<div class="modal fade" id="partModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"><i class="bi bi-tools me-2"></i><span id="partModalTitle">Them phu tung moi</span></h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div id="partModalError" class="alert alert-danger d-none mb-3"></div>
                <form id="partForm">
                    <input type="hidden" id="partId" value="0">
                    <input type="hidden" id="imageUrl" value="">

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label class="form-label">Ten phu tung <span class="text-danger">*</span></label>
                            <input type="text" class="form-control" id="partName" required maxlength="150" placeholder="VD: Lop xe Michelin...">
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Ma phu tung <span class="text-danger">*</span></label>
                            <input type="text" class="form-control" id="partCode" required maxlength="50" placeholder="VD: PT-LOP-01">
                        </div>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label class="form-label">Danh muc <span class="text-danger">*</span></label>
                            <select class="form-select" id="categoryId" required>
                                <option value="">-- Chon danh muc --</option>
                                @foreach (var cat in categories)
                                {
                                    <option value="@cat.CategoryId">@cat.CategoryName</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Thuong hieu / Hang</label>
                            <input type="text" class="form-control" id="brand" maxlength="100" placeholder="VD: Michelin, Bosch...">
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Gia ban (VND) <span class="text-danger">*</span></label>
                        <input type="number" class="form-control" id="price" required min="0">
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Hinh anh san pham (chon nhieu anh)</label>
                        <input type="file" class="form-control" id="partImageFiles" accept="image/*" multiple onchange="handleImgUpload(this)">
                        <small class="text-muted">Ho tro JPG, PNG, WEBP.</small>
                        <div class="d-flex flex-wrap gap-2 mt-2" id="imgPreviewList"></div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Mo ta san pham</label>
                        <textarea class="form-control" id="description" rows="3" placeholder="Mo ta chi tiet phu tung..."></textarea>
                    </div>

                    <div class="text-end border-top pt-3">
                        <button type="button" class="btn btn-secondary me-2" data-bs-dismiss="modal">Huy</button>
                        <button type="submit" class="btn btn-warning fw-bold" id="btnSavePart">Luu phu tung</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<!-- MODAL: Them / Sua Danh Muc -->
<div class="modal fade" id="categoryModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"><i class="bi bi-tags-fill me-2"></i><span id="catModalTitle">Them danh muc moi</span></h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <form id="catForm" onsubmit="saveCategoryForm(event)">
                    <input type="hidden" id="catId" value="0">
                    <div class="mb-3">
                        <label class="form-label">Ten danh muc <span class="text-danger">*</span></label>
                        <input type="text" class="form-control" id="catName" required maxlength="100" placeholder="VD: Lop xe, Dau nhot...">
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Mo ta</label>
                        <textarea class="form-control" id="catDesc" rows="3" placeholder="Mo ta ngan..."></textarea>
                    </div>
                    <div class="text-end border-top pt-3">
                        <button type="button" class="btn btn-secondary me-2" data-bs-dismiss="modal">Huy</button>
                        <button type="submit" class="btn btn-warning fw-bold">Luu danh muc</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        let currentImages = [];

        // Tab switching
        function switchTab(tab) {
            document.getElementById('tabParts').style.display = tab === 'parts' ? 'block' : 'none';
            document.getElementById('tabCats').style.display = tab === 'cats' ? 'block' : 'none';
            document.getElementById('tabBtnParts').classList.toggle('active', tab === 'parts');
            document.getElementById('tabBtnCats').classList.toggle('active', tab === 'cats');
            localStorage.setItem('partsTab', tab);
        }

        document.addEventListener('DOMContentLoaded', function () {
            const saved = localStorage.getItem('partsTab');
            if (saved) switchTab(saved);
        });

        // Filter table
        function filterTable() {
            const term = document.getElementById('searchTerm').value.toLowerCase().trim();
            const cat = document.getElementById('filterCat').value;
            document.querySelectorAll('#partsTable tbody tr').forEach(tr => {
                const name = tr.querySelector('.part-name')?.textContent.toLowerCase() ?? '';
                const code = tr.querySelector('.part-code')?.textContent.toLowerCase() ?? '';
                const catCell = tr.cells[2]?.textContent.trim() ?? '';
                const matchSearch = !term || name.includes(term) || code.includes(term);
                const matchCat = !cat || catCell.includes(cat);
                tr.style.display = (matchSearch && matchCat) ? '' : 'none';
            });
        }

        // ============ PART MODAL ============
        function openAddPartModal() {
            document.getElementById('partId').value = 0;
            document.getElementById('partForm').reset();
            document.getElementById('imageUrl').value = '';
            document.getElementById('partModalTitle').textContent = 'Them phu tung moi';
            document.getElementById('partModalError').classList.add('d-none');
            currentImages = [];
            renderImagePreviews();
            new bootstrap.Modal(document.getElementById('partModal')).show();
        }

        function openEditPartModal(partId) {
            document.getElementById('partModalError').classList.add('d-none');
            document.getElementById('partModalTitle').textContent = 'Cap nhat phu tung';
            currentImages = [];

            fetch(`/Parts/GetPartJson/${partId}`)
                .then(r => r.json())
                .then(p => {
                    document.getElementById('partId').value = p.partId;
                    document.getElementById('partName').value = p.partName || '';
                    document.getElementById('partCode').value = p.partCode || '';
                    document.getElementById('categoryId').value = p.categoryId || '';
                    document.getElementById('brand').value = p.brand || '';
                    document.getElementById('price').value = p.price || 0;
                    document.getElementById('description').value = p.description || '';

                    if (p.imageUrl) {
                        currentImages = p.imageUrl.split(',').map(s => s.trim()).filter(s => s);
                    }
                    document.getElementById('imageUrl').value = currentImages.join(',');
                    renderImagePreviews();

                    new bootstrap.Modal(document.getElementById('partModal')).show();
                })
                .catch(() => Swal.fire('Loi', 'Khong the tai thong tin phu tung.', 'error'));
        }

        function handleImgUpload(input) {
            if (!input.files || !input.files.length) return;
            const formData = new FormData();
            for (let f of input.files) formData.append('files', f);

            Swal.fire({ title: 'Dang tai anh...', allowOutsideClick: false, didOpen: () => Swal.showLoading() });

            $.ajax({
                url: '/Parts/UploadMultipleImages',
                type: 'POST',
                data: formData,
                processData: false,
                contentType: false,
                success: function (res) {
                    Swal.close();
                    if (res.success && res.imageUrls) {
                        res.imageUrls.forEach(u => { if (!currentImages.includes(u)) currentImages.push(u); });
                        renderImagePreviews();
                    } else {
                        Swal.fire('Loi', res.message || 'Khong the tai anh', 'error');
                    }
                },
                error: () => { Swal.close(); Swal.fire('Loi', 'Loi tai anh.', 'error'); }
            });
        }

        function renderImagePreviews() {
            const container = document.getElementById('imgPreviewList');
            container.innerHTML = '';
            currentImages.forEach((url, idx) => {
                const div = document.createElement('div');
                div.className = 'img-preview-box';
                div.innerHTML = `<img src="${url}" alt="img"><button type="button" class="btn-rm" onclick="removeImg(${idx})">x</button>`;
                container.appendChild(div);
            });
            document.getElementById('imageUrl').value = currentImages.join(',');
        }

        function removeImg(idx) {
            currentImages.splice(idx, 1);
            renderImagePreviews();
        }

        // Submit part form
        document.getElementById('partForm').addEventListener('submit', function (e) {
            e.preventDefault();
            const btn = document.getElementById('btnSavePart');
            btn.disabled = true;
            btn.textContent = 'Dang luu...';

            const data = new URLSearchParams({
                PartId: document.getElementById('partId').value,
                PartName: document.getElementById('partName').value.trim(),
                PartCode: document.getElementById('partCode').value.trim(),
                CategoryId: document.getElementById('categoryId').value,
                Brand: document.getElementById('brand').value.trim(),
                Price: document.getElementById('price').value,
                Description: document.getElementById('description').value.trim(),
                ImageUrl: document.getElementById('imageUrl').value.trim()
            });

            fetch('/Parts/Save', { method: 'POST', body: data, headers: { 'Content-Type': 'application/x-www-form-urlencoded' } })
                .then(r => r.json())
                .then(res => {
                    btn.disabled = false;
                    btn.textContent = 'Luu phu tung';
                    if (res.success) {
                        Swal.fire('Thanh cong!', res.message, 'success').then(() => location.reload());
                    } else {
                        document.getElementById('partModalError').innerHTML = res.message;
                        document.getElementById('partModalError').classList.remove('d-none');
                    }
                })
                .catch(() => {
                    btn.disabled = false;
                    btn.textContent = 'Luu phu tung';
                    Swal.fire('Loi!', 'Loi ket noi may chu.', 'error');
                });
        });

        function deletePart(id, name) {
            Swal.fire({
                title: 'Xac nhan xoa?',
                html: `Ban chac chan muon xoa phu tung <b>${name}</b>?`,
                icon: 'warning',
                showCancelButton: true,
                confirmButtonText: 'Xoa ngay',
                cancelButtonText: 'Huy',
                confirmButtonColor: '#dc3545'
            }).then(r => {
                if (!r.isConfirmed) return;
                const data = new URLSearchParams({ id });
                fetch('/Parts/Delete', { method: 'POST', body: data, headers: { 'Content-Type': 'application/x-www-form-urlencoded' } })
                    .then(r => r.json())
                    .then(res => {
                        if (res.success) Swal.fire('Thanh cong!', res.message, 'success').then(() => location.reload());
                        else Swal.fire('Loi!', res.message, 'error');
                    });
            });
        }

        // ============ CATEGORY MODAL ============
        function openAddCategoryModal() {
            document.getElementById('catId').value = 0;
            document.getElementById('catForm').reset();
            document.getElementById('catModalTitle').textContent = 'Them danh muc moi';
            new bootstrap.Modal(document.getElementById('categoryModal')).show();
        }

        function openEditCategoryModal(id, name, desc) {
            document.getElementById('catId').value = id;
            document.getElementById('catName').value = name || '';
            document.getElementById('catDesc').value = desc || '';
            document.getElementById('catModalTitle').textContent = 'Chinh sua danh muc';
            new bootstrap.Modal(document.getElementById('categoryModal')).show();
        }

        function saveCategoryForm(e) {
            e.preventDefault();
            const id = parseInt(document.getElementById('catId').value);
            const payload = {
                categoryName: document.getElementById('catName').value.trim(),
                description: document.getElementById('catDesc').value.trim()
            };

            const url = id === 0 ? '/Parts/CreateCategory' : `/Parts/UpdateCategory/${id}`;
            fetch(url, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(payload)
            })
                .then(r => r.json())
                .then(res => {
                    if (res.success) Swal.fire('Thanh cong!', 'Luu danh muc thanh cong.', 'success').then(() => location.reload());
                    else Swal.fire('Loi', res.message || 'Khong the luu danh muc', 'error');
                })
                .catch(() => Swal.fire('Loi', 'Loi ket noi may chu.', 'error'));
        }
    </script>
}
